@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Admin Login - Level 2</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">

    <style>

            * {
                font-family: 'Inter', sans-serif;
            }

            body {
                margin: 0;
                overflow: hidden;
                background: #050816;
                color: white;
            }

            /* CANVAS BACKGROUND */
            #particles {
                position: absolute;
                width: 100%;
                height: 100%;
                z-index: 0;
            }

            /* MOUSE GLOW */
            .cursor-glow {
                position: absolute;
                width: 300px;
                height: 300px;
                background: radial-gradient(circle, rgba(59,130,246,0.25), transparent 70%);
                border-radius: 50%;
                pointer-events: none;
                transform: translate(-50%, -50%);
                filter: blur(20px);
            }

            /* LAYOUT */
            .wrapper {
                position: relative;
                z-index: 2;
                height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            /* LEFT TEXT */
            .left {
                position: absolute;
                left: 80px;
                max-width: 420px;
            }

                .left h1 {
                    font-size: 52px;
                    font-weight: 800;
                    background: linear-gradient(90deg,#3b82f6,#a855f7,#22d3ee);
                    -webkit-background-clip: text;
                    -webkit-text-fill-color: transparent;
                }

            .typing {
                color: #94a3b8;
                margin-top: 10px;
                min-height: 24px;
            }

            /* GLASS CARD */
            .card-glass {
                width: 380px;
                padding: 32px;
                border-radius: 20px;
                background: rgba(255,255,255,0.07);
                backdrop-filter: blur(20px);
                border: 1px solid rgba(255,255,255,0.12);
                box-shadow: 0 0 60px rgba(0,0,0,0.6);
                animation: fadeIn 1s ease;
            }

            @@keyframes fadeIn {
                from {
                    opacity: 0;
                    transform: translateY(20px) scale(0.95);
                }

                to {
                    opacity: 1;
                    transform: translateY(0) scale(1);
                }
            }

            label {
                font-size: 13px;
                color: #cbd5e1;
            }

            .form-control {
                background: rgba(255,255,255,0.05);
                border: 1px solid rgba(255,255,255,0.2);
                color: white;
                padding: 12px;
                border-radius: 12px;
                transition: 0.3s;
            }

                .form-control:focus {
                    box-shadow: 0 0 20px rgba(59,130,246,0.5);
                    border-color: #3b82f6;
                }

            /* BUTTON LOADING */
            .btn-login {
                width: 100%;
                padding: 12px;
                border: none;
                border-radius: 12px;
                font-weight: bold;
                background: linear-gradient(135deg,#3b82f6,#9333ea);
                color: white;
                position: relative;
                overflow: hidden;
                transition: 0.3s;
            }

                .btn-login:hover {
                    transform: scale(1.05);
                    box-shadow: 0 0 25px rgba(147,51,234,0.5);
                }

            .loader {
                display: none;
                width: 18px;
                height: 18px;
                border: 2px solid #fff;
                border-top: 2px solid transparent;
                border-radius: 50%;
                animation: spin 1s linear infinite;
                margin: auto;
            }

            @@keyframes spin {
                100% {
                    transform: rotate(360deg);
                }
            }

    </style>
</head>

<body>

    <canvas id="particles"></canvas>
    <div class="cursor-glow" id="cursor"></div>

    <div class="wrapper">

        <!-- LEFT -->
        <div class="left d-none d-lg-block">
            <h1>CMS ADMIN</h1>
            <div class="typing" id="typing"></div>
        </div>

        <!-- LOGIN CARD -->
        <div class="card-glass">

            <h4 class="text-center mb-4">🔐 Secure Login</h4>

            <form asp-action="Login" method="post" onsubmit="startLoading()">

                <div class="mb-3">
                    <label>Username</label>
                    <input name="username" class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Password</label>
                    <input name="password" type="password" class="form-control" />
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }

                <button class="btn-login" id="btnLogin">
                    <span id="btnText">Login</span>
                    <div class="loader" id="loader"></div>
                </button>

            </form>

        </div>

    </div>

    <script>
            /* =======================
               PARTICLE BACKGROUND
            ======================= */
            const canvas = document.getElementById("particles");
            const ctx = canvas.getContext("2d");

            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;

            let particles = [];

            for (let i = 0; i < 80; i++) {
                particles.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    r: Math.random() * 2,
                    dx: (Math.random() - 0.5),
                    dy: (Math.random() - 0.5)
                });
            }

            function draw() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);

                ctx.fillStyle = "white";
                particles.forEach(p => {
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                    ctx.fill();

                    p.x += p.dx;
                    p.y += p.dy;

                    if (p.x < 0 || p.x > canvas.width) p.dx *= -1;
                    if (p.y < 0 || p.y > canvas.height) p.dy *= -1;
                });

                requestAnimationFrame(draw);
            }
            draw();

            /* =======================
               MOUSE GLOW
            ======================= */
            document.addEventListener("mousemove", (e) => {
                const cursor = document.getElementById("cursor");
                cursor.style.left = e.clientX + "px";
                cursor.style.top = e.clientY + "px";
            });

            /* =======================
               TYPING EFFECT
            ======================= */
            const text = "Secure • Fast • Future-ready Admin System";
            let i = 0;

            function type() {
                if (i < text.length) {
                    document.getElementById("typing").innerHTML += text.charAt(i);
                    i++;
                    setTimeout(type, 50);
                }
            }
            type();

            /* =======================
               LOADING BUTTON
            ======================= */
            function startLoading() {
                document.getElementById("btnText").style.display = "none";
                document.getElementById("loader").style.display = "block";
            }
    </script>

</body>
</html>
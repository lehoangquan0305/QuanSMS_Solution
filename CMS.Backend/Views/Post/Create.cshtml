@model CMS.Data.Entities.Post

@{
    ViewData["Title"] = "Thêm bài viết";
}

<div class="container mt-5">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold text-success">
                ➕ THÊM BÀI VIẾT
            </h2>

            <p class="text-muted">
                Tạo bài viết mới cho hệ thống
            </p>
        </div>

        <a href="/Post"
           class="btn btn-outline-secondary shadow-sm">
            ↩ Quay lại
        </a>

    </div>

    <!-- CARD -->
    <div class="card border-0 shadow-lg rounded-4">

        <div class="card-header bg-success py-3 rounded-top-4">

            <h4 class="mb-0 fw-semibold text-white">
                📝 Thông tin bài viết
            </h4>

        </div>

        <div class="card-body p-4">

            <form method="post" enctype="multipart/form-data">

                <!-- TITLE -->
                <div class="mb-4">

                    <label class="form-label fw-bold">
                        Tiêu đề bài viết
                    </label>

                    <input asp-for="Title"
                           class="form-control form-control-lg" />

                </div>

                <!-- CATEGORY -->
                <div class="mb-4">

                    <label class="form-label fw-bold">
                        Danh mục
                    </label>

                    <select asp-for="CategoryId"
                            class="form-select form-select-lg">

                        <option value="">
                            -- Chọn danh mục --
                        </option>

                        @foreach (var item in ViewBag.CategoryList)
                        {
                            <option value="@item.Id">
                                @item.Name
                            </option>
                        }

                    </select>

                </div>

                <!-- IMAGE -->
                <div class="mb-4">

                    <label class="form-label fw-bold">
                        Hình ảnh
                    </label>

                    <input type="file"
                           name="uploadImage"
                           class="form-control" />

                </div>

                <!-- CONTENT -->
                <div class="mb-4">

                    <label class="form-label fw-bold">
                        Nội dung
                    </label>

                    <textarea asp-for="Content"
                              class="form-control"
                              rows="8"></textarea>

                </div>

                <!-- BUTTON -->
                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-success btn-lg px-4 shadow-sm">

                        💾 Lưu bài viết

                    </button>

                    <a href="/Post"
                       class="btn btn-secondary btn-lg px-4">

                        Hủy

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>
@section Scripts {

    <script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>

    <script>

        ClassicEditor
        .create(document.querySelector('#Content'))
        .catch(error => {
        console.error(error);
        });

    </script>

}
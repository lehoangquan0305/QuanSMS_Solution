@model CMS.Data.Entities.Post

@{
    ViewData["Title"] = "Chỉnh sửa bài viết";
}

<div class="container mt-5">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold text-warning">
                ✏ CHỈNH SỬA BÀI VIẾT
            </h2>

            <p class="text-muted">
                Cập nhật thông tin bài viết
            </p>
        </div>

        <a href="/Post"
           class="btn btn-outline-secondary shadow-sm">
            ↩ Quay lại
        </a>

    </div>

    <!-- CARD -->
    <div class="card border-0 shadow-lg rounded-4">

        <div class="card-header bg-warning py-3 rounded-top-4">

            <h4 class="mb-0 fw-semibold text-dark">
                📝 Thông tin bài viết
            </h4>

        </div>

        <div class="card-body p-4">

            <form asp-action="Edit"
                  method="post"
                  enctype="multipart/form-data">

                <input asp-for="Id" type="hidden" />
                <input asp-for="ImageUrl" type="hidden" />
                <input asp-for="CreatedDate" type="hidden" />

                <div asp-validation-summary="All"
                     class="text-danger mb-3">
                </div>

                <!-- TITLE -->
                <div class="mb-4">

                    <label asp-for="Title"
                           class="form-label fw-bold">
                    </label>

                    <input asp-for="Title"
                           class="form-control form-control-lg" />

                    <span asp-validation-for="Title"
                          class="text-danger"></span>

                </div>

                <!-- CATEGORY -->
                <div class="mb-4">

                    <label asp-for="CategoryId"
                           class="form-label fw-bold">
                        Danh mục
                    </label>

                    <select asp-for="CategoryId"
                            class="form-select form-select-lg">

                        <option value="">
                            -- Chọn danh mục --
                        </option>

                        @foreach (var item in ViewBag.CategoryList)
                        {
                            <option value="@item.Id">
                                @item.Name
                            </option>
                        }

                    </select>

                    <span asp-validation-for="CategoryId"
                          class="text-danger"></span>

                </div>

                <!-- IMAGE -->
                <div class="mb-4">

                    <label class="form-label fw-bold">
                        Hình ảnh hiện tại
                    </label>

                    <br />

                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl"
                             alt="Ảnh bài viết"
                             style="width:220px;
                        height:140px;
                        object-fit:cover;
                        border-radius:12px;
                        border:1px solid #ddd;
                        margin-bottom:15px;" />
                    }

                </div>

                <div class="mb-4">

                    <label for="uploadImage"
                           class="form-label fw-bold">
                        Chọn ảnh mới
                    </label>

                    <input type="file"
                           id="uploadImage"
                           name="uploadImage"
                           class="form-control"
                           accept="image/*" />

                </div>

                <!-- CONTENT -->
                <div class="mb-4">

                    <label asp-for="Content"
                           class="form-label fw-bold">
                        Nội dung
                    </label>

                    <textarea asp-for="Content"
                              class="form-control"
                              rows="8"></textarea>

                    <span asp-validation-for="Content"
                          class="text-danger"></span>

                </div>

                <!-- BUTTON -->
                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-warning btn-lg px-4 shadow-sm">
                        💾 Cập nhật
                    </button>

                    <a href="/Post"
                       class="btn btn-secondary btn-lg px-4">
                        Hủy
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>

    <script>
        ClassicEditor
        .create(document.querySelector('#Content'))
        .catch(error => {
        console.error(error);
        });
    </script>
}
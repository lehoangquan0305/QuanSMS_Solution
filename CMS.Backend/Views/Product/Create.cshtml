@model CMS.Data.Entities.Product

@{
    ViewData["Title"] = "Thêm Sản Phẩm";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold text-success">
                ➕ THÊM SẢN PHẨM
            </h2>

            <p class="text-muted">
                Tạo sản phẩm mới cho hệ thống
            </p>
        </div>

        <a href="/Product"
           class="btn btn-outline-secondary shadow-sm">
            ↩ Quay lại
        </a>

    </div>

    <div class="card border-0 shadow-lg rounded-4">

        <div class="card-header bg-success text-white py-3 rounded-top-4">
            <h4 class="mb-0 fw-semibold">
                🛒 Thông tin sản phẩm
            </h4>
        </div>

        <div class="card-body p-4">

            <form method="post" enctype="multipart/form-data">

                <!-- NAME -->
                <div class="mb-4">

                    <label asp-for="Name"
                           class="form-label fw-bold">
                    </label>

                    <input asp-for="Name"
                           id="Name"
                           class="form-control form-control-lg"
                           placeholder="Nhập tên sản phẩm..." />

                    <span asp-validation-for="Name"
                          class="text-danger"></span>

                </div>

                <!-- CATEGORY -->
                <div class="mb-4">

                    <label asp-for="CategoryProductId"
                           class="form-label fw-bold">
                        Danh mục sản phẩm
                    </label>

                    <select asp-for="CategoryProductId"
                            id="CategoryProductId"
                            class="form-select form-select-lg">

                        <option value="">
                            -- Chọn danh mục --
                        </option>

                        @foreach (var item in ViewBag.CategoryList)
                        {
                            <option value="@item.Id">
                                @item.Name
                            </option>
                        }

                    </select>

                    <span asp-validation-for="CategoryProductId"
                          class="text-danger"></span>

                </div>

                <!-- PRICE -->
                <div class="mb-4">

                    <label asp-for="Price"
                           class="form-label fw-bold">
                    </label>

                    <input asp-for="Price"
                           id="Price"
                           class="form-control form-control-lg"
                           placeholder="Ví dụ: 15000000" />

                    <span asp-validation-for="Price"
                          class="text-danger"></span>

                </div>

                <!-- STOCK -->
                <div class="mb-4">

                    <label asp-for="StockQuantity"
                           class="form-label fw-bold">
                    </label>

                    <input asp-for="StockQuantity"
                           id="StockQuantity"
                           class="form-control form-control-lg"
                           placeholder="Ví dụ: 20" />

                    <span asp-validation-for="StockQuantity"
                          class="text-danger"></span>

                </div>

                <!-- IMAGE -->
                <div class="mb-4">

                    <label asp-for="ImageUrl"
                           class="form-label fw-bold">
                    </label>

                    <input type="file"
                           name="uploadImage"
                           class="form-control" />

                    <span asp-validation-for="ImageUrl"
                          class="text-danger"></span>

                </div>

                <!-- DESCRIPTION -->
                <div class="mb-4">

                    <label asp-for="Description"
                           class="form-label fw-bold">
                    </label>

                    <textarea asp-for="Description"
                              id="Description"
                              class="form-control"
                              rows="6"
                              placeholder="Nhập mô tả sản phẩm..."></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger"></span>

                </div>

                <!-- BUTTON -->
                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-success btn-lg px-4 shadow-sm">
                        💾 Lưu sản phẩm
                    </button>

                    <a href="/Product"
                       class="btn btn-secondary btn-lg px-4">
                        Hủy
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
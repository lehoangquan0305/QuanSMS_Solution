@model CMS.Data.Entities.Product

@{
    ViewData["Title"] = "Thêm Sản Phẩm";
}

<div class="container-fluid px-4 py-4 animate-fade-in" style="font-family: 'Segoe UI', sans-serif;">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3 page-header-animate">
        <div>
            <h2 class="fw-black text-dark mb-1 text-uppercase d-flex align-items-center gap-2">
                <span class="pulse-icon">➕</span> THÊM SẢN PHẨM MỚI
            </h2>
            <p class="text-muted mb-0 fw-semibold">
                Kiến tạo và cập nhật mặt hàng mới vào hệ thống Store Adidas
            </p>
        </div>
        <a href="/Product" class="btn btn-outline-dark d-flex align-items-center gap-2 px-3 py-2 fw-bold shadow-sm rounded-3">
            ↩️ Quay lại danh sách
        </a>
    </div>

    <form method="post" enctype="multipart/form-data">
        <div class="row g-4">

            <div class="col-lg-8">
                <div class="card card-premium shadow border-0 p-4">
                    <div class="border-bottom border-light pb-3 mb-4">
                        <h4 class="mb-0 fw-bold text-secondary d-flex align-items-center gap-2">
                            📝 Thông tin cơ bản
                        </h4>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-bold text-dark">Tên sản phẩm</label>
                        <input asp-for="Name" id="Name" class="form-control custom-input-admin" placeholder="Ví dụ: Giày Adidas Ultraboost Ligh..." />
                        <span asp-validation-for="Name" class="text-danger small fw-semibold mt-1 d-block"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CategoryProductId" class="form-label fw-bold text-dark">Danh mục sản phẩm</label>
                            <select asp-for="CategoryProductId" id="CategoryProductId" class="form-select custom-input-admin">
                                <option value="">-- Chọn danh mục --</option>
                                @foreach (var item in ViewBag.CategoryList)
                                {
                                    <option value="@item.Id">@item.Name</option>
                                }
                            </select>
                            <span asp-validation-for="CategoryProductId" class="text-danger small fw-semibold mt-1 d-block"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="StockQuantity" class="form-label fw-bold text-dark">Số lượng tồn kho</label>
                            <input asp-for="StockQuantity" id="StockQuantity" type="number" min="0" class="form-control custom-input-admin" placeholder="Ví dụ: 50" />
                            <span asp-validation-for="StockQuantity" class="text-danger small fw-semibold mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Price" class="form-label fw-bold text-dark">Giá bán lẻ (đ)</label>
                        <div class="input-group">
                            <input asp-for="Price" id="Price" type="number" step="0.01" class="form-control custom-input-admin" placeholder="Ví dụ: 3500000" />
                            <span class="input-group-text bg-light fw-bold text-secondary">VND</span>
                        </div>
                        <span asp-validation-for="Price" class="text-danger small fw-semibold mt-1 d-block"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-bold text-dark">Mô tả sản phẩm</label>
                        <textarea asp-for="Description" id="Description" class="form-control custom-input-admin" rows="5" placeholder="Nhập tóm tắt công nghệ đệm, chất liệu vải Primeknit, hướng dẫn chọn size..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small fw-semibold mt-1 d-block"></span>
                    </div>

                    <div class="d-flex gap-2 mt-4 pt-3 border-top border-light">
                        <button type="submit" class="btn btn-gradient-success px-4 py-2 fw-bold d-flex align-items-center gap-2">
                            💾 Lưu vào hệ thống
                        </button>
                        <a href="/Product" class="btn btn-light border px-4 py-2 fw-bold text-secondary">
                            Hủy bỏ
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card card-premium shadow border-0 p-4 h-100">
                    <div class="border-bottom border-light pb-3 mb-4">
                        <h4 class="mb-0 fw-bold text-secondary d-flex align-items-center gap-2">
                            🖼️ Hình ảnh hiển thị
                        </h4>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark">Chọn file từ máy tính</label>
                        <div class="upload-zone-box">
                            <input type="file" name="uploadImage" id="imageInput" class="form-control file-input-hidden" accept="image/*" />
                            <div class="upload-placeholder-text text-center py-4" id="uploadPlaceholder">
                                <span class="fs-1 d-block mb-2">☁️</span>
                                <span class="fw-semibold text-primary d-block">Click để chọn ảnh</span>
                                <small class="text-muted">Hỗ trợ JPG, PNG, WEBP</small>
                            </div>
                        </div>
                        <span asp-validation-for="ImageUrl" class="text-danger small fw-semibold mt-1 d-block"></span>
                    </div>

                    <div class="preview-container text-center">
                        <label class="form-label fw-bold text-secondary d-block text-start mb-2">Ảnh xem trước:</label>
                        <div class="img-preview-wrapper rounded-3 shadow-sm border">
                            <img id="imagePreview" src="https://via.placeholder.com/400x300?text=Ch%C6%B0a+C%C3%B3+%E1%BA%A2nh" class="img-fluid rounded-3" alt="Preview Image" />
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </form>
</div>

<style>
    .fw-black {
        font-weight: 900 !important;
    }

    /* Hiệu ứng Header & Card */
    .page-header-animate {
        animation: slideDownAdmin 0.4s ease-out;
    }

    .pulse-icon {
        display: inline-block;
        animation: pulseEffect 2s infinite ease-in-out;
    }

    .card-premium {
        border-radius: 16px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.03) !important;
        background: #ffffff;
    }

    /* Input Focus Hoạt họa phong cách Hiện đại */
    .custom-input-admin {
        padding: 12px 16px;
        border: 1px solid #cbd5e1;
        border-radius: 10px;
        font-size: 0.95rem;
        transition: all 0.3s ease;
    }

        .custom-input-admin:focus {
            border-color: #10b981 !important;
            box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.15) !important;
            background-color: #fff;
        }

    /* Khối tải file thiết kế tinh gọn */
    .upload-zone-box {
        position: relative;
        border: 2px dashed #cbd5e1;
        border-radius: 12px;
        background: #f8fafc;
        cursor: pointer;
        transition: all 0.25s ease;
        overflow: hidden;
    }

        .upload-zone-box:hover {
            border-color: #10b981;
            background: #f0fdf4;
        }

    .file-input-hidden {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: pointer;
        z-index: 5;
    }

    /* Wrapper Khung hiển thị ảnh xem trước */
    .img-preview-wrapper {
        background: #f1f5f9;
        min-height: 200px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

        .img-preview-wrapper img {
            max-height: 280px;
            width: 100%;
            object-fit: cover;
            transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .img-preview-wrapper:hover img {
            transform: scale(1.05);
        }

    /* Nút Submit Gradient */
    .btn-gradient-success {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: #fff;
        border: none;
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.25);
        transition: all 0.25s ease;
    }

        .btn-gradient-success:hover {
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(16, 185, 129, 0.35);
        }

    /* Keyframes Hoạt Họa */
    @@keyframes slideDownAdmin {
        from {
            opacity: 0;
            transform: translateY(-15px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes pulseEffect {
        0%, 100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.15);
        }
    }

    .animate-fade-in {
        animation: fadeInAdmin 0.5s cubic-bezier(0.16, 1, 0.3, 1) ease;
    }

    @@keyframes fadeInAdmin {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.getElementById('imageInput').addEventListener('change', function (event) {
            const file = event.target.files[0];
            const preview = document.getElementById('imagePreview');
            const placeholder = document.getElementById('uploadPlaceholder');

            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                    placeholder.innerHTML = ` <span class="fs-3 d-block">✅</span><span class="text-success fw-bold d-block">Đã nạp file thành công!</span><small class="text-muted text-truncate d-block px-2">${file.name}</small>`;
                };
                reader.readAsDataURL(file);
            } else {
                preview.src = "https://via.placeholder.com/400x300?text=Ch%C6%B0a+C%C3%B3+%E1%BA%A2nh";
                placeholder.innerHTML = `<span class="fs-1 d-block mb-2">☁️</span><span class="fw-semibold text-primary d-block">Click để chọn ảnh</span><small class="text-muted">Hỗ trợ JPG, PNG, WEBP</small>`;
            }
        });
    </script>
}
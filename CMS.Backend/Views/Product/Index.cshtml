@model IEnumerable<CMS.Data.Entities.Product>

@{
    ViewData["Title"] = "Quản lý sản phẩm";

    // Tích hợp thuật toán phân trang logic cơ bản ngay trên View
    // (Hoặc tốt nhất bạn nên truyền các biến này từ Controller qua ViewBag nhé)
    int pageSize = 5; // Số sản phẩm trên mỗi trang
    int currentPage = Context.Request.Query["page"].ToString() != "" ? int.Parse(Context.Request.Query["page"]) : 1;
    int totalItems = Model.Count();
    int totalPages = (int)Math.Ceiling((double)totalItems / pageSize);

    var pagedData = Model.Skip((currentPage - 1) * pageSize).Take(pageSize);
}

<div class="container-fluid px-4 py-4" style="font-family: 'Segoe UI', sans-serif;">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3 page-header-animate">
        <div>
            <h2 class="fw-black text-dark mb-1 text-uppercase d-flex align-items-center gap-2">
                <span class="pulse-icon">👟</span> QUẢN LÝ SẢN PHẨM
            </h2>
            <p class="text-muted mb-0 fw-semibold">
                Hệ thống lưu trữ tổng số <span class="text-primary fw-bold">@totalItems</span> sản phẩm trong kho hàng
            </p>
        </div>
        <a href="/Product/Create" class="btn btn-gradient-success d-flex align-items-center gap-2 px-4 py-2fw-bold">
            <span>➕</span> Thêm sản phẩm mới
        </a>
    </div>

    <div class="card card-premium shadow border-0 overflow-hidden animate-fade-in">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-custom align-middle mb-0">
                    <thead>
                        <tr>
                            <th width="80" class="ps-4">ID</th>
                            <th width="120">Hình ảnh</th>
                            <th>Tên sản phẩm</th>
                            <th>Danh mục</th>
                            <th>Giá bán</th>
                            <th>Tồn kho</th>
                            <th width="200" class="text-center pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!pagedData.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted fw-bold">
                                    Không tìm thấy sản phẩm nào trong hệ thống!
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in pagedData)
                            {
                                <tr class="table-row-hover">
                                    <td class="ps-4 text-secondary fw-bold">
                                        #@item.Id
                                    </td>
                                    <td>
                                        <div class="image-container-admin animate-img">
                                            <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://via.placeholder.com/150" : item.ImageUrl)"
                                                 alt="@item.Name"
                                                 class="img-fluid rounded shadow-sm" />
                                        </div>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark text-truncate-custom">@item.Name</div>
                                    </td>
                                    <td>
                                        <span class="badge badge-premium">
                                            @(item.CategoryProduct?.Name ?? "Chưa phân loại")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="fw-extrabold text-danger fs-6">
                                            @item.Price.ToString("N0") đ
                                        </span>
                                    </td>
                                    <td>
                                        @if (item.StockQuantity <= 5)
                                        {
                                            <span class="badge bg-soft-danger text-danger fw-bold">🔥 Sắp hết hàng (@item.StockQuantity)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-soft-success text-success fw-bold">✔️ Còn @item.StockQuantity</span>
                                        }
                                    </td>
                                    <td class="text-center pe-4">
                                        <div class="d-flex justify-content-center gap-2">
                                            <a href="/Product/Edit/@item.Id" class="btn btn-action btn-action-edit" title="Chỉnh sửa sản phẩm">
                                                ✏️ Sửa
                                            </a>
                                            <a href="/Product/Delete/@item.Id"
                                               class="btn btn-action btn-action-delete"
                                               onclick="return confirm('Hành động này không thể hoàn tác! Bạn có chắc chắn muốn xóa sản phẩm này?')"
                                               title="Xóa sản phẩm">
                                                🗑️ Xóa
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (totalPages > 1)
        {
            <div class="card-footer bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center border-top border-light">
                <div class="text-muted small fw-semibold">
                    Hiển thị trang <span class="text-dark fw-bold">@currentPage</span> trên tổng số <span class="text-dark fw-bold">@totalPages</span> trang
                </div>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-premium m-0 gap-1">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="?page=@(currentPage - 1)" aria-label="Previous">
                                <span>«</span>
                            </a>
                        </li>

                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(currentPage == i ? "active" : "")">
                                <a class="page-link" href="?page=@i">@i</a>
                            </li>
                        }

                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" href="?page=@(currentPage + 1)" aria-label="Next">
                                <span>»</span>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<style>
    /* Tổng quan */
    .fw-black {
        font-weight: 900 !important;
    }

    .fw-extrabold {
        font-weight: 800 !important;
    }

    /* Hiệu ứng Header */
    .page-header-animate {
        animation: slideDownAdmin 0.5s ease-out;
    }

    .pulse-icon {
        display: inline-block;
        animation: pulseEffect 2s infinite ease-in-out;
    }

    /* Thẻ Card chứa bảng */
    .card-premium {
        border-radius: 16px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.04) !important;
        background: #ffffff;
    }

    /* Style cấu trúc Table */
    .table-custom {
        border-collapse: separate;
        border-spacing: 0;
    }

        .table-custom thead th {
            background: #0f172a;
            color: #f8fafc;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.8rem;
            letter-spacing: 0.5px;
            padding: 18px 12px;
            border: none;
        }

        .table-custom tbody tr {
            transition: all 0.25s ease;
        }

    .table-row-hover:hover {
        background-color: #f8fafc !important;
    }

    /* Hiệu ứng Phóng to / Xoay nhẹ ảnh khi hover chuột vào hàng */
    .image-container-admin {
        width: 70px;
        height: 70px;
        overflow: hidden;
        border-radius: 10px;
        background: #f1f5f9;
        display: flex;
        align-items: center;
        justifyContent: center;
        transition: transform 0.3s ease;
    }

        .image-container-admin img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: all 0.4s ease;
        }

    .table-row-hover:hover .image-container-admin img {
        transform: scale(1.15) rotate(3deg);
    }

    /* Badge & Text */
    .badge-premium {
        background: #e0f2fe;
        color: #0369a1;
        font-weight: 700;
        padding: 6px 12px;
        border-radius: 30px;
        font-size: 0.8rem;
    }

    .bg-soft-danger {
        background: #fee2e2;
    }

    .bg-soft-success {
        background: #dcfce7;
    }

    .text-truncate-custom {
        max-width: 250px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Nút Tạo Mới */
    .btn-gradient-success {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: #fff;
        border: none;
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
        transition: all 0.3s ease;
    }

        .btn-gradient-success:hover {
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(16, 185, 129, 0.4);
        }

    /* Hệ thống nút hành động */
    .btn-action {
        border: none;
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 700;
        transition: all 0.2s ease;
    }

    .btn-action-edit {
        background: #fef3c7;
        color: #d97706;
    }

        .btn-action-edit:hover {
            background: #d97706;
            color: #fff;
        }

    .btn-action-delete {
        background: #fee2e2;
        color: #dc2626;
    }

        .btn-action-delete:hover {
            background: #dc2626;
            color: #fff;
        }

    /* Phân trang Premium */
    .pagination-premium .page-link {
        border: 1px solid #e2e8f0;
        color: #475569;
        padding: 8px 16px;
        border-radius: 8px !important;
        font-weight: 600;
        font-size: 0.9rem;
        transition: all 0.2s ease;
    }

    .pagination-premium .page-item.active .page-link {
        background: #0f172a;
        border-color: #0f172a;
        color: #fff;
    }

    .pagination-premium .page-link:hover {
        background: #f1f5f9;
        color: #0f172a;
    }

    /* Các Keyframes Hoạt Họa */
    @@keyframes slideDownAdmin {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    @@keyframes pulseEffect {
        0%, 100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.15);
        }
    }

    .animate-fade-in {
        animation: fadeInAdmin 0.6s cubic-bezier(0.16, 1, 0.3, 1) ease;
    }
    @@keyframes fadeInAdmin {
        from {
            opacity: 0;
            transform: translateY(15px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
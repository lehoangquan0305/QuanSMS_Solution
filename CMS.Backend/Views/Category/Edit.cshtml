@model CMS.Data.Entities.Category

@{
    ViewData["Title"] = "Chỉnh Sửa Danh Mục";
}

<div class="container mt-5">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold text-warning mb-1">
                ✏ CHỈNH SỬA DANH MỤC
            </h2>

            <p class="text-muted">
                Cập nhật thông tin danh mục trong hệ thống CMS
            </p>
        </div>

        <a href="/Category"
           class="btn btn-outline-secondary shadow-sm">
            ↩ Quay lại
        </a>

    </div>

    <!-- CARD -->
    <div class="card border-0 shadow-lg rounded-4">

        <!-- HEADER CARD -->
        <div class="card-header bg-warning text-dark py-3 rounded-top-4">

            <h4 class="mb-0 fw-semibold">
                🛠 Cập nhật danh mục
            </h4>

        </div>

        <!-- BODY -->
        <div class="card-body p-4">

            <form method="post">

                <!-- ID HIDDEN -->
                <input asp-for="Id" hidden />

                <!-- NAME -->
                <div class="mb-4">

                    <label class="form-label fw-bold">
                        Tên danh mục
                    </label>

                    <input asp-for="Name"
                           class="form-control form-control-lg"
                           placeholder="Nhập tên danh mục..." />

                    <span asp-validation-for="Name"
                          class="text-danger"></span>

                </div>

                <!-- DESCRIPTION -->
                <div class="mb-4">

                    <label class="form-label fw-bold">
                        Mô tả
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="5"
                              placeholder="Nhập mô tả danh mục..."></textarea>

                </div>

                <!-- BUTTON -->
                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-warning btn-lg px-4 shadow-sm text-white">

                        💾 Cập nhật

                    </button>

                    <a href="/Category"
                       class="btn btn-secondary btn-lg px-4">

                        Hủy

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
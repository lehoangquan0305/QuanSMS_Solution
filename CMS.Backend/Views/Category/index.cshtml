@model IEnumerable<CMS.Data.Entities.Category>

@{
    ViewData["Title"] = "Quản Lý Danh Mục";
}

<div class="container-fluid px-4 py-4 animate-fade-in" style="font-family: 'Segoe UI', sans-serif;">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3 page-header-animate flex-wrap">
        <div>
            <h2 class="fw-black text-dark mb-1 text-uppercase d-flex align-items-center gap-2">
                <span class="pulse-icon">📂</span> QUẢN LÝ DANH MỤC
            </h2>
            <p class="text-muted mb-0 fw-semibold d-flex align-items-center gap-2">
                Phân loại cấu trúc sản phẩm Adidas hệ thống | Tổng số:
                <span class="badge bg-soft-primary text-primary px-2.5 py-1 rounded-3 font-monospace">@Model.Count()</span>
            </p>
        </div>

        <div class="d-flex gap-2 align-items-center flex-sm-nowrap flex-wrap input-group-container">
            <div class="position-relative search-wrapper">
                <input type="text" id="searchInput" class="form-control custom-search-input" placeholder="🔍 Tìm nhanh danh mục..." />
            </div>

            <a asp-action="Create" class="btn btn-gradient-success d-flex align-items-center gap-2 px-4 py-2 fw-bold text-nowrap">
                <span>➕</span> Thêm danh mục mới
            </a>
        </div>
    </div>

    <div class="card card-premium shadow border-0 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-custom align-middle mb-0" id="categoryTable">
                    <thead>
                        <tr>
                            <th width="100" class="ps-4">ID</th>
                            <th width="300">Tên Danh Mục</th>
                            <th>Mô Tả Chi Tiết</th>
                            <th width="220" class="text-center pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr class="table-row-hover data-row">
                                    <td class="ps-4">
                                        <span class="badge bg-light text-secondary border font-monospace px-2 py-1">#@item.Id</span>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark d-flex align-items-center gap-2 text-primary-hover">
                                            🏷️ @item.Name
                                        </div>
                                    </td>
                                    <td>
                                        <div class="text-muted text-truncate-description" title="@item.Description">
                                            @(string.IsNullOrEmpty(item.Description) ? "Chưa có mô tả cho danh mục này" : item.Description)
                                        </div>
                                    </td>
                                    <td class="text-center pe-4">
                                        <div class="d-flex justify-content-center gap-2">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-action btn-action-edit">
                                                ✏️ Sửa
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-action btn-action-delete" onclick="return confirm('Bạn chắc chắn muốn xóa danh mục này?')">
                                                🗑️ Xóa
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr id="noDataRowStatic">
                                <td colspan="4" class="text-center text-muted py-5">
                                    <span class="fs-2 d-block mb-2">😢</span> Không có danh mục nào tồn tại trong hệ thống
                                </td>
                            </tr>
                        }
                        <tr id="noSearchDataRow" style="display: none;">
                            <td colspan="4" class="text-center text-muted py-5">
                                <span class="fs-2 d-block mb-2">🔍</span> Không tìm thấy danh mục nào phù hợp với từ khóa!
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .fw-black {
        font-weight: 900 !important;
    }

    .page-header-animate {
        animation: slideDownAdmin 0.4s ease-out;
    }

    .pulse-icon {
        display: inline-block;
        animation: pulseEffect 2s infinite ease-in-out;
    }

    /* Thiết kế thẻ Card */
    .card-premium {
        border-radius: 16px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.03) !important;
        background: #ffffff;
    }

    /* Định dạng thanh tìm kiếm custom */
    .search-wrapper {
        min-width: 260px;
    }

    .custom-search-input {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 8px 16px;
        font-weight: 600;
        color: #334155;
        transition: all 0.25s ease;
    }

        .custom-search-input:focus {
            background: #ffffff;
            border-color: #3b82f6;
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.15);
        }

    /* Style Bảng cấu trúc phẳng */
    .table-custom {
        border-collapse: separate;
        border-spacing: 0;
    }

        .table-custom thead th {
            background: #0f172a;
            color: #f8fafc;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.8rem;
            letter-spacing: 0.5px;
            padding: 18px 12px;
            border: none;
        }

        .table-custom tbody tr {
            transition: all 0.2s ease;
        }

    .table-row-hover:hover {
        background-color: #f8fafc !important;
    }

    /* Giới hạn text mô tả danh mục dài */
    .text-truncate-description {
        max-width: 450px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Nút thêm mới Gradient */
    .btn-gradient-success {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: #fff;
        border: none;
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.25);
        transition: all 0.25s ease;
    }

        .btn-gradient-success:hover {
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(16, 185, 129, 0.35);
        }

    /* Badge phong cách mới */
    .bg-soft-primary {
        background: #eff6ff;
    }

    /* Cụm nút hành động Sửa / Xóa */
    .btn-action {
        border: none;
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 700;
        transition: all 0.2s ease;
        text-decoration: none;
    }

    .btn-action-edit {
        background: #fef3c7;
        color: #d97706;
    }

        .btn-action-edit:hover {
            background: #d97706;
            color: #fff;
        }

    .btn-action-delete {
        background: #fee2e2;
        color: #dc2626;
    }

        .btn-action-delete:hover {
            background: #dc2626;
            color: #fff;
        }

    /* Khắc phục triệt để dấu trùng lặp với C# Razor */
    @@keyframes slideDownAdmin {
        from {
            opacity: 0;
            transform: translateY(-15px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes pulseEffect {
        0%, 100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.15);
        }
    }

    .animate-fade-in {
        animation: fadeInAdmin 0.5s cubic-bezier(0.16, 1, 0.3, 1) ease;
    }

    @@keyframes fadeInAdmin {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("searchInput");
        const noSearchDataRow = document.getElementById("noSearchDataRow");

        if (searchInput) {
            searchInput.addEventListener("keyup", function () {
                const filter = this.value.toLowerCase().trim();
                const rows = document.querySelectorAll("#categoryTable tbody tr.data-row");
                let hasVisibleRow = false;

                rows.forEach(row => {
                    const text = row.innerText.toLowerCase();
                    if (text.includes(filter)) {
                        row.style.display = "";
                        hasVisibleRow = true;
                    } else {
                        row.style.display = "none";
                    }
                });

                // Nếu có bộ lọc nhập vào mà không tìm thấy kết quả nào thì bật dòng thông báo trống lên
                if (filter !== "" && !hasVisibleRow) {
                    noSearchDataRow.style.display = "";
                } else {
                    noSearchDataRow.style.display = "none";
                }
            });
        }
    });
</script>
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CMS Admin</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;900&display=swap" rel="stylesheet">

    <style>
            * {
                font-family: 'Inter', sans-serif;
            }

            body {
                margin: 0;
                background: #f8fafc; /* Màu nền xám dịu mắt theo tiêu chuẩn Dashboard mới */
                color: #1e293b;
                overflow-x: hidden;
            }

            /* KHUNG WRAPPER CHÍNH */
            .admin-wrapper {
                display: flex;
                min-height: 100vh;
            }

            /* SIDEBAR CAO CẤP */
            .sidebar {
                width: 280px;
                background: #0f172a;
                color: white;
                position: fixed;
                height: 100vh;
                padding: 28px 20px;
                overflow-y: auto;
                z-index: 100;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                box-shadow: 4px 0 20px rgba(15, 23, 42, 0.08);
                transition: all 0.3s ease;
            }

            /* Logo thương hiệu */
            .sidebar-logo {
                display: flex;
                align-items: center;
                gap: 14px;
                margin-bottom: 35px;
                padding-left: 8px;
            }

            .logo-icon {
                width: 48px;
                height: 48px;
                border-radius: 14px;
                background: linear-gradient(135deg, #3b82f6, #06b6d4);
                display: flex;
                align-items: center;
                justify-content: center;
                font-weight: 900;
                font-size: 16px;
                color: white;
                box-shadow: 0 8px 16px rgba(59, 130, 246, 0.25);
            }

            .sidebar-logo h3 {
                font-size: 1.15rem;
                font-weight: 800;
                margin: 0;
                letter-spacing: 0.5px;
                background: linear-gradient(135deg, #ffffff, #cbd5e1);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }

            /* Danh sách Menu điều hướng */
            .sidebar-menu {
                list-style: none;
                padding: 0;
                margin: 0;
            }

                .sidebar-menu li {
                    margin-bottom: 6px;
                }

                .sidebar-menu a {
                    display: flex;
                    align-items: center;
                    gap: 12px;
                    text-decoration: none;
                    color: #94a3b8;
                    padding: 12px 16px;
                    border-radius: 12px;
                    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
                    font-weight: 500;
                    font-size: 0.92rem;
                }

                    .sidebar-menu a:hover {
                        background: #1e293b;
                        color: #f8fafc;
                        transform: translateX(4px);
                    }

                    .sidebar-menu a.active {
                        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
                        color: white;
                        font-weight: 600;
                        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
                    }

            /* Chân Sidebar (User Profile) */
            .sidebar-footer {
                border-top: 1px solid #1e293b;
                padding-top: 20px;
                margin-top: 25px;
            }

            .admin-user img {
                width: 42px;
                height: 42px;
                border-radius: 12px;
                object-fit: cover;
                border: 2px solid #334155;
                transition: border-color 0.3s;
            }

            .admin-user:hover img {
                border-color: #3b82f6;
            }

            /* KHU VỰC HIỂN THỊ NỘI DUNG CHÍNH */
            .main-content {
                margin-left: 280px;
                flex: 1;
                padding: 30px 40px;
                min-width: 0; /* Chống vỡ layout hệ thống khi bảng quá rộng */
            }

            /* THANH ĐẦU TRANG (TOPBAR THỦY TINH phẳng) */
            .topbar {
                background: rgba(255, 255, 255, 0.85);
                backdrop-filter: blur(12px);
                -webkit-backdrop-filter: blur(12px);
                border: 1px solid rgba(226, 232, 240, 0.8);
                border-radius: 16px;
                padding: 16px 28px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 32px;
                box-shadow: 0 4px 20px rgba(15, 23, 42, 0.02);
                animation: fadeInLayout 0.4s ease-out;
            }

                .topbar h1 {
                    font-size: 1.35rem;
                    font-weight: 800;
                    color: #0f172a;
                    margin-bottom: 2px;
                }

            .topbar-right {
                display: flex;
                gap: 14px;
                align-items: center;
            }

            /* Ô tìm kiếm chung của hệ thống */
            .global-search-box input {
                border: 1px solid #e2e8f0;
                background: #f1f5f9;
                padding: 10px 16px;
                border-radius: 10px;
                width: 240px;
                outline: none;
                font-size: 0.9rem;
                transition: all 0.2s;
            }

                .global-search-box input:focus {
                    background: #ffffff;
                    border-color: #3b82f6;
                    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
                }

            /* Nút thông báo */
            .notification-btn {
                border: 1px solid #e2e8f0;
                background: #ffffff;
                width: 42px;
                height: 42px;
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                transition: all 0.2s;
            }

                .notification-btn:hover {
                    background: #f1f5f9;
                    transform: scale(1.03);
                }

            /* KHẮC PHỤC TRIỆT ĐỂ LỖI RAZOR MEDIA QUERY */
            @@media (max-width: 1024px) {
                .sidebar {
                    transform: translateX(-100%);
                    position: fixed;
                }

                    .sidebar.active-mobile {
                        transform: translateX(0);
                    }

                .main-content {
                    margin-left: 0;
                    padding: 20px;
                }
                /* Thêm nút menu mobile nếu cần phát triển về sau */
            }

            @@media (max-width: 768px) {
                .topbar {
                    flex-direction: column;
                    gap: 16px;
                    align-items: flex-start;
                    padding: 18px;
                }

                .topbar-right {
                    width: 100%;
                    justify-content: space-between;
                }

                .global-search-box {
                    flex: 1;
                }

                    .global-search-box input {
                        width: 100%;
                    }
            }

            @@keyframes fadeInLayout {
                from {
                    opacity: 0;
                    transform: translateY(-8px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }
    </style>
</head>
<body>

    <div class="admin-wrapper">

        <aside class="sidebar" id="adminSidebar">
            <div>
                <div class="sidebar-logo">
                    <div class="logo-icon">CMS</div>
                    <div>
                        <h3>QUAN-CMS</h3>
                    </div>
                </div>

                <ul class="sidebar-menu">
                    <li>
                        <a href="/" class="@(Context.Request.Path == "/" ? "active" : "")">
                            <span>📊</span> Dashboard
                        </a>
                    </li>
                    <li>
                        <a href="/Category" class="@(Context.Request.Path.StartsWithSegments("/Category") && !Context.Request.Path.StartsWithSegments("/CategoryProduct") ? "active" : "")">
                            <span>📂</span> Danh Mục Tin Tức
                        </a>
                    </li>
                    <li>
                        <a href="/Post" class="@(Context.Request.Path.StartsWithSegments("/Post") ? "active" : "")">
                            <span>📰</span> Bài Viết
                        </a>
                    </li>
                    <li>
                        <a href="/CategoryProduct" class="@(Context.Request.Path.StartsWithSegments("/CategoryProduct") ? "active" : "")">
                            <span>🏷️</span> Danh Mục Sản Phẩm
                        </a>
                    </li>
                    <li>
                        <a href="/Product" class="@(Context.Request.Path.StartsWithSegments("/Product") ? "active" : "")">
                            <span>🛒</span> Sản Phẩm
                        </a>
                    </li>
                    <li>
                        <a href="/Order" class="@(Context.Request.Path.StartsWithSegments("/Order") || Context.Request.Path.StartsWithSegments("/OrderDetail") ? "active" : "")">
                            <span>📦</span> Đơn Hàng Hệ Thống
                        </a>
                    </li>
                    <li class="py-2"><hr style="border-color: #334155; margin: 0;" /></li>
                    <li>
                        <a href="/User" class="@(Context.Request.Path.StartsWithSegments("/User") ? "active" : "")">
                            <span>👤</span> Quản Trị Viên
                        </a>
                    </li>
                    <li>
                        <a href="/Customer" class="@(Context.Request.Path.StartsWithSegments("/Customer") ? "active" : "")">
                            <span>👥</span> Tài Khoản Khách Hàng
                        </a>
                    </li>
                </ul>
            </div>

            <div class="sidebar-footer">
                @if (User.Identity.IsAuthenticated)
                {
                    <div class="admin-user d-flex align-items-center gap-3">
                        <img src="https://i.pravatar.cc/100?u=@User.Identity.Name" alt="Avatar User" />
                        <div class="flex-grow-1 min-w-0">
                            <h6 class="mb-0 text-white fw-bold text-truncate" style="font-size: 0.9rem;">
                                @User.FindFirst("FullName")?.Value
                            </h6>
                            <small class="text-muted d-block text-truncate" style="font-size: 0.75rem;">
                                @User.Identity.Name
                            </small>
                            <span class="badge bg-primary mt-1" style="font-size: 0.7rem; padding: 3px 6px;">
                                @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                            </span>
                        </div>
                    </div>
                    <div class="mt-3">
                        <a asp-controller="Account" asp-action="Logout" class="btn btn-sm btn-outline-danger w-100 fw-bold border-0" style="border-radius:10px; background: rgba(239,68,68,0.1)">
                            🚪 Đăng xuất
                        </a>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted mb-2">
                        <small style="font-size: 0.8rem;">Hệ thống chưa đăng nhập</small>
                    </div>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm w-100 fw-bold" style="border-radius:10px;">
                        🔐 Đăng nhập hệ thống
                    </a>
                }
            </div>
        </aside>

        <main class="main-content">

            <div class="topbar">
                <div>
                    <h1>@ViewData["Title"]</h1>
                    <p class="text-muted mb-0" style="font-size: 0.85rem; font-weight: 500;">
                        Hệ thống quản lý nội dung & thương mại điện tử chuyên sâu ⚡
                    </p>
                </div>

                <div class="topbar-right">
                    <div class="global-search-box">
                        <input type="text" placeholder="Tìm tác vụ nhanh..." />
                    </div>
                    <button class="notification-btn" title="Thông báo hệ thống">
                        🔔
                    </button>
                </div>
            </div>

            @RenderBody()

        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
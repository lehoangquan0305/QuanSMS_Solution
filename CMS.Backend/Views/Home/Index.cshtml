@{
    ViewData["Title"] = "Trang Chủ";
}

<div class="container mt-5">

    <!-- Tiêu đề -->
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-primary">
            HỆ THỐNG QUẢN LÝ CMS
        </h1>

        <p class="lead text-muted">
            ASP.NET Core MVC + Entity Framework Core + SQL Server
        </p>
    </div>

    <!-- Dashboard -->
    <div class="row g-4">

        <!-- Category -->
        <div class="col-md-4">
            <div class="card shadow-lg border-0 h-100">
                <div class="card-body text-center">
                    <h3 class="text-primary">Danh Mục</h3>

                    <p class="text-muted">
                        Quản lý các danh mục bài viết
                    </p>

                    <a href="/Category"
                       class="btn btn-primary">
                        Xem Danh Mục
                    </a>
                </div>
            </div>
        </div>

        <!-- Post -->
        <div class="col-md-4">
            <div class="card shadow-lg border-0 h-100">
                <div class="card-body text-center">
                    <h3 class="text-success">Bài Viết</h3>

                    <p class="text-muted">
                        Quản lý nội dung bài viết
                    </p>

                    <a href="/Post"
                       class="btn btn-success">
                        Xem Bài Viết
                    </a>
                </div>
            </div>
        </div>

        <!-- User -->
        <div class="col-md-4">
            <div class="card shadow-lg border-0 h-100">
                <div class="card-body text-center">
                    <h3 class="text-danger">Người Dùng</h3>

                    <p class="text-muted">
                        Quản lý tài khoản hệ thống
                    </p>

                    <a href="/User"
                       class="btn btn-danger">
                        Xem Người Dùng
                    </a>
                </div>
            </div>
        </div>

        <!-- Product -->
        <div class="col-md-4">
            <div class="card shadow-lg border-0 h-100">
                <div class="card-body text-center">
                    <h3 class="text-warning">Sản Phẩm</h3>

                    <p class="text-muted">
                        Quản lý sản phẩm website
                    </p>

                    <a href="/Product"
                       class="btn btn-warning text-white">
                        Xem Sản Phẩm
                    </a>
                </div>
            </div>
        </div>

        <!-- Customer -->
        <div class="col-md-4">
            <div class="card shadow-lg border-0 h-100">
                <div class="card-body text-center">
                    <h3 class="text-info">Khách Hàng</h3>

                    <p class="text-muted">
                        Quản lý thông tin khách hàng
                    </p>

                    <a href="/Customer"
                       class="btn btn-info text-white">
                        Xem Khách Hàng
                    </a>
                </div>
            </div>
        </div>

        <!-- Order -->
        <div class="col-md-4">
            <div class="card shadow-lg border-0 h-100">
                <div class="card-body text-center">
                    <h3 class="text-dark">Đơn Hàng</h3>

                    <p class="text-muted">
                        Theo dõi và xử lý đơn hàng
                    </p>

                    <a href="/Order"
                       class="btn btn-dark">
                        Xem Đơn Hàng
                    </a>
                </div>
            </div>
        </div>

    </div>

</div>
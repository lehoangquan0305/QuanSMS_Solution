@model IEnumerable<CMS.Data.Entities.Customer>

@{
    ViewData["Title"] = "Quản Lý Khách Hàng";
}

<div class="container-fluid px-4 py-4 animate-fade-in" style="font-family: 'Segoe UI', sans-serif;">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3 page-header-animate">
        <div>
            <h2 class="fw-black text-dark mb-1 text-uppercase d-flex align-items-center gap-2">
                <span class="pulse-icon">👥</span> QUẢN LÝ KHÁCH HÀNG
            </h2>
            <p class="text-muted mb-0 fw-semibold">
                Danh sách tài khoản khách mua hàng và thông tin bảo mật hệ thống Store Adidas
            </p>
        </div>
        <a href="/Customer/Create" class="btn btn-gradient-success d-flex align-items-center gap-2 px-4 py-2 fw-bold">
            <span>➕</span> Thêm khách hàng mới
        </a>
    </div>

    <div class="card card-premium shadow border-0 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-custom align-middle mb-0">
                    <thead>
                        <tr>
                            <th width="80" class="ps-4">ID</th>
                            <th>Họ tên</th>
                            <th>Thông tin liên hệ</th>
                            <th>Địa chỉ</th>
                            <th width="160">Mật khẩu</th>
                            <th width="180" class="text-center pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="table-row-hover">
                                <td class="ps-4 text-secondary fw-bold">
                                    #@item.Id
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-circle-customer">
                                            @(string.IsNullOrEmpty(item.FullName) ? "C" : item.FullName.Substring(0, 1).ToUpper())
                                        </div>
                                        <div>
                                            <span class="fw-bold text-dark d-block">@item.FullName</span>
                                            <small class="text-muted font-monospace">@item.Phone</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="text-secondary fw-semibold">@item.Email</div>
                                </td>
                                <td>
                                    <div class="text-muted text-truncate-address" title="@item.Address">@item.Address</div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2 dynamic-password-box">
                                        <span class="password-text font-monospace fw-bold text-secondary text-sm" data-real-password="@item.Password">••••••••</span>
                                        <button class="btn-toggle-eye" onclick="togglePassword(this)" title="Xem/Ẩn mật khẩu">
                                            👁️
                                        </button>
                                    </div>
                                </td>
                                <td class="text-center pe-4">
                                    <div class="d-flex justify-content-center gap-2">
                                        <a href="/Customer/Edit/@item.Id" class="btn btn-action btn-action-edit">
                                            ✏️ Sửa
                                        </a>
                                        <a href="/Customer/Delete/@item.Id" class="btn btn-action btn-action-delete" onclick="return confirm('Bạn có chắc chắn muốn xóa khách hàng này không?')">
                                            🗑️ Xóa
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .fw-black {
        font-weight: 900 !important;
    }

    /* Hoạt họa mượt mà */
    .page-header-animate {
        animation: slideDownAdmin 0.4s ease-out;
    }

    .pulse-icon {
        display: inline-block;
        animation: pulseEffect 2s infinite ease-in-out;
    }

    /* Thiết kế thẻ Card */
    .card-premium {
        border-radius: 16px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.03) !important;
        background: #ffffff;
    }

    /* Style Bảng cấu trúc phẳng */
    .table-custom {
        border-collapse: separate;
        border-spacing: 0;
    }

        .table-custom thead th {
            background: #0f172a;
            color: #f8fafc;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.8rem;
            letter-spacing: 0.5px;
            padding: 18px 12px;
            border: none;
        }

        .table-custom tbody tr {
            transition: all 0.2s ease;
        }

    .table-row-hover:hover {
        background-color: #f8fafc !important;
    }

    /* Khung giả lập avatar tên khách hàng */
    .avatar-circle-customer {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: #f1f5f9;
        color: #475569;
        font-weight: 700;
        display: flex;
        align-items: center;
        justifyContent: center;
        border: 1px solid #e2e8f0;
    }

    /* Giới hạn text địa chỉ nếu quá dài */
    .text-truncate-address {
        max-width: 220px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Style khối ẩn hiện mật khẩu */
    .dynamic-password-box {
        background: #f8fafc;
        padding: 4px 10px;
        border-radius: 6px;
        border: 1px solid #e2e8f0;
        display: inline-flex !important;
    }

    .btn-toggle-eye {
        border: none;
        background: transparent;
        cursor: pointer;
        font-size: 0.85rem;
        padding: 0;
        transition: transform 0.2s;
    }

        .btn-toggle-eye:hover {
            transform: scale(1.2);
        }

    /* Nút thêm mới Gradient */
    .btn-gradient-success {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: #fff;
        border: none;
        border-radius: 10px;
        box-shadow: 0 4px 15px rgba(16, 185, 129, 0.25);
        transition: all 0.25s ease;
    }

        .btn-gradient-success:hover {
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(16, 185, 129, 0.35);
        }

    /* Cụm nút hành động Sửa / Xóa */
    .btn-action {
        border: none;
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 700;
        transition: all 0.2s ease;
        text-decoration: none;
    }

    .btn-action-edit {
        background: #fef3c7;
        color: #d97706;
    }

        .btn-action-edit:hover {
            background: #d97706;
            color: #fff;
        }

    .btn-action-delete {
        background: #fee2e2;
        color: #dc2626;
    }

        .btn-action-delete:hover {
            background: #dc2626;
            color: #fff;
        }

    /* Khắc phục triệt để dấu trùng lặp với C# Razor */
    @@keyframes slideDownAdmin {
        from {
            opacity: 0;
            transform: translateY(-15px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes pulseEffect {
        0%, 100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.15);
        }
    }

    .animate-fade-in {
        animation: fadeInAdmin 0.5s cubic-bezier(0.16, 1, 0.3, 1) ease;
    }

    @@keyframes fadeInAdmin {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<script>
    function togglePassword(button) {
        const textSpan = button.previousElementSibling;
        const realPassword = textSpan.getAttribute('data-real-password');

        if (textSpan.innerText === '••••••••') {
            textSpan.innerText = realPassword;
            button.innerText = '🔒';
        } else {
            textSpan.innerText = '••••••••';
            button.innerText = '👁️';
        }
    }
</script>
@model IEnumerable<CMS.Data.Entities.Customer>
<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary">👥 QUẢN LÝ KHÁCH HÀNG</h2>
            <p class="text-muted">Danh sách khách hàng trong hệ thống</p>
        </div>
        <a href="/Customer/Create" class="btn btn-success shadow-sm">➕ Thêm khách hàng</a>
    </div>

    <div class="card border-0 shadow-lg rounded-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Họ tên</th>
                            <th>Email</th>
                            <th>Điện thoại</th>
                            <th>Địa chỉ</th>
                            <th>Mật khẩu</th>
                            <th width="180">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><strong>#@item.Id</strong></td>
                                <td class="fw-semibold text-primary">@item.FullName</td>
                                <td>@item.Email</td>
                                <td>@item.Phone</td>
                                <td>@item.Address</td>
                                <td>
                                    @* Cấu trúc nâng cao: Ẩn text và kèm nút bấm chuyển đổi *@
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="password-text font-monospace" data-real-password="@item.Password">••••••••</span>
                                        <button class="btn btn-sm btn-light border-0 text-secondary p-1 memory-eye-btn" onclick="togglePassword(this)">
                                            👁️
                                        </button>
                                    </div>
                                </td>
                                <td>
                                    <a href="/Customer/Edit/@item.Id" class="btn btn-sm btn-outline-warning">✏ Sửa</a>
                                    <a href="/Customer/Delete/@item.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('Bạn có chắc muốn xóa?')">🗑 Xóa</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@* Script bổ trợ tính năng Click Ẩn/Hiện *@
<script>
    function togglePassword(button) {
        const textSpan = button.previousElementSibling;
        const realPassword = textSpan.getAttribute('data-real-password');

        if (textSpan.innerText === '••••••••') {
            textSpan.innerText = realPassword;
            button.innerText = '🔒';
        } else {
            textSpan.innerText = '••••••••';
            button.innerText = '👁️';
        }
    }
</script>
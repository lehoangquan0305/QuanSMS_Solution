@model IEnumerable<CMS.Data.Entities.Order>

@{
    ViewData["Title"] = "Quản Lý Đơn Hàng";
}

<div class="container-fluid px-4 py-4 animate-fade-in" style="font-family: 'Segoe UI', sans-serif;">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3 page-header-animate">
        <div>
            <h2 class="fw-black text-dark mb-1 text-uppercase d-flex align-items-center gap-2">
                <span class="pulse-icon">📦</span> QUẢN LÝ ĐƠN HÀNG
            </h2>
            <p class="text-muted mb-0 fw-semibold">
                Theo dõi quy trình xử lý, trạng thái vận chuyển và lịch sử mua sắm
            </p>
        </div>
    </div>

    <div class="card card-premium shadow border-0 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-custom align-middle mb-0">
                    <thead>
                        <tr>
                            <th width="100" class="ps-4">Mã Đơn</th>
                            <th>Ngày Đặt</th>
                            <th>Khách Hàng</th>
                            <th>Trạng Thái</th>
                            <th>Ghi Chú Hệ Thống</th>
                            <th width="150" class="text-center pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="table-row-hover">
                                <td class="ps-4 text-dark fw-bold">
                                    <span class="badge bg-light text-dark border font-monospace px-2 py-1">#@item.Id</span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-secondary">
                                        📅 @item.OrderDate.ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="avatar-circle-order">👤</div>
                                        <span class="fw-bold text-primary">
                                            @(item.Customer != null ? item.Customer.FullName : "Khách vãng lai")
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <select class="form-select form-select-sm" onchange="updateStatus(@item.Id, this.value)">
                                        <option value="0" selected="@(item.Status == 0)">⏳ Chờ duyệt</option>
                                        <option value="1" selected="@(item.Status == 1)">🚚 Đang giao</option>
                                        <option value="2" selected="@(item.Status == 2)">✅ Hoàn thành</option>
                                        <option value="3" selected="@(item.Status == 3)">❌ Đã hủy</option>
                                    </select>
                                </td>
                                <td>
                                    <small class="text-muted text-truncate-notes" title="@item.Notes">
                                        @(string.IsNullOrEmpty(item.Notes) ? "---" : item.Notes)
                                    </small>
                                </td>
                                <td class="text-center pe-4">
                                    <a href="/OrderDetail/Index?orderId=@item.Id" class="btn btn-action btn-action-view d-inline-flex align-items-center gap-1">
                                        🔍 Xem chi tiết
                                    </a>
                                    <button onclick="deleteOrder(@item.Id)" class="btn btn-sm btn-outline-danger">🗑️ Xóa</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .fw-black {
        font-weight: 900 !important;
    }

    .page-header-animate {
        animation: slideDownAdmin 0.4s ease-out;
    }

    .pulse-icon {
        display: inline-block;
        animation: pulseEffect 2s infinite ease-in-out;
    }

    .card-premium {
        border-radius: 16px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.03) !important;
        background: #ffffff;
    }

    .table-custom {
        border-collapse: separate;
        border-spacing: 0;
    }

        .table-custom thead th {
            background: #0f172a;
            color: #f8fafc;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.8rem;
            letter-spacing: 0.5px;
            padding: 18px 12px;
            border: none;
        }

        .table-custom tbody tr {
            transition: all 0.2s ease;
        }

    .table-row-hover:hover {
        background-color: #f8fafc !important;
    }

    .avatar-circle-order {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .badge-status {
        font-weight: 700;
        border-radius: 6px;
        font-size: 0.85rem;
    }

    .bg-soft-warning {
        background: #fffbeb;
    }

    .bg-soft-info {
        background: #e0f2fe;
    }

    .bg-soft-success {
        background: #dcfce7;
    }

    .text-truncate-notes {
        max-width: 200px;
        display: inline-block;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .btn-action-view {
        background: #e2e8f0;
        color: #334155;
        text-decoration: none;
    }

        .btn-action-view:hover {
            background: #0f172a;
            color: #fff;
        }

    .btn-action {
        border: none;
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 700;
        transition: all 0.2s ease;
    }

    @@keyframes slideDownAdmin {
        from {
            opacity: 0;
            transform: translateY(-15px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes pulseEffect {
        0%, 100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.15);
        }
    }

    .animate-fade-in {
        animation: fadeInAdmin 0.5s cubic-bezier(0.16, 1, 0.3, 1) ease;
    }

    @@keyframes fadeInAdmin {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
<script>
    async function updateStatus(id, status) {
        if (!confirm("Xác nhận cập nhật trạng thái đơn hàng?")) return;

        const response = await fetch(`/Order/UpdateStatus?id=${id}&status=${status}`, { method: 'POST' });
        if (response.ok) {
            location.reload(); // Tải lại trang để cập nhật giao diện
        }
    }

    async function deleteOrder(id) {
        if (!confirm("Bạn có chắc chắn muốn xóa đơn hàng này? Việc này không thể hoàn tác!")) return;

        const response = await fetch(`/Order/DeleteOrder?id=${id}`, { method: 'POST' });
        if (response.ok) {
            location.reload();
        } else {
            alert("Lỗi khi xóa đơn hàng.");
        }
    }
</script>
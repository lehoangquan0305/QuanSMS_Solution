@model IEnumerable<CMS.Data.Entities.OrderDetail>

@{
    ViewData["Title"] = "Chi Tiết Đơn Hàng Premium";
    decimal totalOrderInvoice = 0;
    var firstItem = Model.FirstOrDefault();
    var orderId = firstItem?.OrderId;
    var orderStatus = firstItem?.Order?.Status; // Lấy trạng thái từ liên kết thực thể Order
}

<div class="container-fluid px-4 py-4 animate-fade-in" style="font-family: 'Segoe UI', sans-serif;">

    <!-- TOP BANNER HEADER -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3 page-header-animate">
        <div>
            <h2 class="fw-black text-dark mb-1 text-uppercase d-flex align-items-center gap-2" style="letter-spacing: -0.5px;">
                <span class="pulse-icon">🧾</span> CHI TIẾT ĐƠN HÀNG
            </h2>
            <div class="d-flex flex-wrap align-items-center gap-2 mt-1">
                <p class="text-muted mb-0 fw-semibold">
                    Danh sách sản phẩm thuộc Mã đơn:
                    <span class="text-primary fw-black font-monospace fs-5">#@(orderId.HasValue ? orderId.ToString() : "---")</span>
                </p>
                <span class="text-muted d-none d-md-inline">•</span>

                <!-- Hiển thị nhanh trạng thái đơn hàng liên kết -->
                @if (orderStatus.HasValue)
                {
                    if (orderStatus == 0)
                    {
                        <span class="badge bg-soft-warning text-warning px-3 py-1.5 rounded-pill fw-bold small-badge-pulse">⏳ Chờ duyệt</span>
                    }
                    else if (orderStatus == 1)
                    {
                        <span class="badge bg-soft-info text-info px-3 py-1.5 rounded-pill fw-bold small-badge-pulse">🚚 Đang giao</span>
                    }
                    else
                    {
                        <span class="badge bg-soft-success text-success px-3 py-1.5 rounded-pill fw-bold">✅ Hoàn thành</span>
                    }
                }
            </div>
        </div>
        <a href="/Order" class="btn btn-premium-back d-flex align-items-center gap-2 px-4 py-2.5 fw-bold shadow-sm">
            <span class="back-arrow">↩️</span> Quay lại danh sách
        </a>
    </div>

    <!-- MAIN ARTICLE CARD -->
    <div class="card card-premium shadow border-0 overflow-hidden mb-4 animate-slide-up">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-custom align-middle mb-0">
                    <thead>
                        <tr>
                            <th width="80" class="ps-4 text-center">STT</th>
                            <th width="120" class="text-center">Hình Ảnh</th>
                            <th>Thông Tin Sản Phẩm</th>
                            <th class="text-center" width="120">Số Lượng</th>
                            <th class="text-end" width="180">Đơn Giá</th>
                            <th class="text-end pe-4" width="220">Thành Tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            int index = 1;
                            foreach (var item in Model)
                            {
                                var subTotal = item.Quantity * item.UnitPrice;
                                totalOrderInvoice += subTotal;

                                // Xử lý Logic nạp ảnh chuẩn chỉ, chống vỡ link
                                string imgUrl = "https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=200"; // Ảnh placeholder mặc định tuyển chọn
                                if (item.Product != null && !string.IsNullOrEmpty(item.Product.ImageUrl))
                                {
                                    imgUrl = item.Product.ImageUrl.StartsWith("http")
                                        ? item.Product.ImageUrl
                                        : "https://localhost:7052" + item.Product.ImageUrl;
                                }

                                <tr class="table-row-hover animate-row" style="--row-index: @index">
                                    <td class="ps-4 text-center text-muted font-monospace fw-semibold">
                                        #@index.ToString("D2")
                                    </td>
                                    <td class="text-center">
                                        <div class="product-img-wrapper shadow-sm">
                                            <img src="@imgUrl" alt="Product Image" onerror="this.src='https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=200';" />
                                        </div>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark text-hover-primary fs-6 mb-0.5">
                                            @(item.Product != null ? item.Product.Name : "Sản phẩm đã ngừng kinh doanh hoặc bị xóa")
                                        </div>
                                        <div class="d-flex gap-2 align-items-center mt-1">
                                            <span class="badge bg-light text-secondary border font-monospace px-2 py-0.5" style="font-size: 0.75rem;">ID: #@item.ProductId</span>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-dark text-white font-monospace px-3 py-2 rounded-3 fw-bold fs-6">
                                            @item.Quantity
                                        </span>
                                    </td>
                                    <td class="text-end font-monospace fw-semibold text-secondary fs-6">
                                        @item.UnitPrice.ToString("N0") <span class="small-currency">đ</span>
                                    </td>
                                    <td class="text-end pe-4 font-monospace fw-black text-success fs-5">
                                        @subTotal.ToString("N0") <span class="small-currency">đ</span>
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted fw-semibold">
                                    📭 Đơn hàng này hiện chưa có dữ liệu chi tiết sản phẩm.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- FOOTER TỔNG TIỀN ĐẲNG CẤP -->
        <div class="card-footer invoice-footer border-0 py-4 px-4 text-end border-top">
            <div class="d-inline-flex flex-column align-items-end">
                <div class="mb-1 text-uppercase text-muted fw-bold tracking-wider" style="font-size: 0.8rem; letter-spacing: 1px;">
                    Tổng giá trị thanh toán đợt này:
                </div>
                <div class="d-flex align-items-baseline gap-1">
                    <span class="fs-2 fw-black text-danger font-monospace leading-none">@totalOrderInvoice.ToString("N0")</span>
                    <span class="fs-4 fw-bold text-danger">đ</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- LUXURY CORE ARCHITECTURE STYLESHEET -->
<style>
    .fw-black {
        font-weight: 900 !important;
    }

    .fw-extrabold {
        font-weight: 800 !important;
    }

    /* HIỆU ỨNG CHUYỂN ĐỘNG TRANG CHÍNH */
    .page-header-animate {
        animation: slideDownAdmin 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .pulse-icon {
        display: inline-block;
        animation: pulseEffect 2.5s infinite ease-in-out;
    }

    .animate-fade-in {
        animation: fadeInAdmin 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .animate-slide-up {
        animation: slideUpAdmin 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* CARD VÀ LAYOUT PHẲNG CAO CẤP */
    .card-premium {
        border-radius: 24px;
        box-shadow: 0 20px 40px rgba(15, 23, 42, 0.04) !important;
        background: #ffffff;
        border: 1px solid rgba(226, 232, 240, 0.8) !important;
    }

    .table-custom {
        border-collapse: separate;
        border-spacing: 0;
    }

        .table-custom thead th {
            background: #0f172a;
            color: #f8fafc;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.78rem;
            letter-spacing: 0.8px;
            padding: 20px 14px;
            border: none;
        }

    /* HIỆU ỨNG TỪNG DÒNG KHI LOAD TRANG (STAGGERED ANIMATION) */
    .animate-row {
        opacity: 0;
        transform: translateY(12px);
        animation: rowFadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        animation-delay: calc(var(--row-index) * 0.06s);
    }

    .table-row-hover {
        transition: all 0.25s ease;
    }

        .table-row-hover:hover {
            background-color: #f8fafc !important;
        }

    /* THIẾT KẾ KHUNG ẢNH SẢN PHẨM */
    .product-img-wrapper {
        width: 70px;
        height: 70px;
        border-radius: 14px;
        overflow: hidden;
        margin: 0 auto;
        border: 2px solid #ffffff;
        background: #f1f5f9;
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

        .product-img-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .table-row-hover:hover .product-img-wrapper {
        transform: scale(1.1) rotate(2deg);
    }

    /* BADGE TRẠNG THÁI MỚI */
    .bg-soft-warning {
        background: #fffbeb;
    }

    .bg-soft-info {
        background: #e0f2fe;
    }

    .bg-soft-success {
        background: #dcfce7;
    }

    .small-badge-pulse {
        animation: badgePulse 2s infinite ease-in-out;
    }

    /* NÚT QUAY LẠI PREMIUM */
    .btn-premium-back {
        background: #ffffff;
        color: #1e293b;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        transition: all 0.25s ease;
    }

        .btn-premium-back:hover {
            background: #0f172a;
            color: #ffffff;
            border-color: #0f172a;
            transform: translateY(-2px);
        }

            .btn-premium-back:hover .back-arrow {
                display: inline-block;
                transform: translateX(-3px);
                transition: transform 0.2s;
            }

    /* INVOICE TOTAL AREA */
    .invoice-footer {
        background: linear-gradient(to right, #f8fafc, #f1f5f9);
        border-top: 1px solid #e2e8f0 !important;
    }

    .small-currency {
        font-size: 0.85rem;
        font-weight: 700;
        margin-left: 1px;
    }

    /* ĐỊNH NGHĨA KEYFRAMES @@ */
    @@keyframes rowFadeIn {
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes slideDownAdmin {
        from {
            opacity: 0;
            transform: translateY(-15px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes slideUpAdmin {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes pulseEffect {
        0%, 100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.12);
        }
    }

    @@keyframes fadeInAdmin {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    @@keyframes badgePulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0.75;
        }
    }
</style>